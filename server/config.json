{
    "server": {
        "host": "0.0.0.0",
        "port": 8080,
        "web_port": 8081,
        "client_port": 8081,
        "max_clients": 10,
        "max_viewers": 20
    },
    "security": {
        "authentication": {
            "enabled": true,
            "username": "admin",
            "password": "admin123",
            "password_hash": null
        },
        "sessions": {
            "enabled": true,
            "token_expiry": 3600,
            "session_timeout": 1800
        },
        "ip_filtering": {
            "enabled": false,
            "allowed_ips": ["127.0.0.1", "::1", "192.168.1.0/24"],
            "blocked_ips": []
        },
        "rate_limiting": {
            "enabled": true,
            "max_requests": 100,
            "window_seconds": 60,
            "ban_duration": 300
        },
        "ssl": {
            "enabled": false,
            "certfile": "cert.pem",
            "keyfile": "key.pem"
        },
        "cors": {
            "enabled": true,
            "allowed_origins": ["*"],
            "allowed_methods": ["GET", "POST", "OPTIONS"],
            "allowed_headers": ["Content-Type", "Authorization"]
        }
    },
    "video": {
        "frame_quality": 85,
        "max_frame_size": 2097152,
        "default_scale": 1.0
    },
    "logging": {
        "level": "INFO",
        "file": "server.log",
        "max_size": 10485760,
        "backup_count": 5
    }
}
